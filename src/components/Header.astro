---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

import versions from '../../versions.json';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;

// One pill per section. Hardware spans the NXS and the Hub pages.
const tabs = [
	{
		label: 'Start',
		href: `${baseUrl}getting-started/overview/`,
		prefixes: [`${baseUrl}getting-started/`],
	},
	{ label: 'Guides', href: `${baseUrl}guides/`, prefixes: [`${baseUrl}guides/`] },
	{
		label: 'Hardware',
		href: `${baseUrl}hardware/product-description/`,
		prefixes: [`${baseUrl}hardware/`, `${baseUrl}hub/`],
	},
	{ label: 'Reference', href: `${baseUrl}reference/`, prefixes: [`${baseUrl}reference/`] },
];

// The edition label names the release the root of the site documents; the
// release-export workflow appends each published tag to versions.json.
const latest = versions.at(-1)?.slug;
const edition = latest ? `NXS · ${latest}` : 'NXS · SENSOR CO-PROCESSOR';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
		<span class="wordmark-sub">aliensense / documentation</span>
	</div>
	<nav class="tabs sl-hidden lg:sl-flex" aria-label="Sections">
		{
			tabs.map((tab) => (
				<a
					href={tab.href}
					aria-current={tab.prefixes.some((p) => currentPath.startsWith(p)) ? 'page' : undefined}
				>
					{tab.label}
				</a>
			))
		}
	</nav>
	<div class="right-group sl-flex print:hidden">
		<span class="edition">{edition}</span>
		<div class="search-wrapper sl-flex">{shouldRenderSearch && <Search />}</div>
		<div class="sl-hidden md:sl-flex pickers">
			<ThemeSelect />
			<LanguageSelect />
		</div>
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			align-items: baseline;
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.right-group {
			align-items: center;
			gap: 1.25rem;
		}

		.search-wrapper {
			justify-content: flex-end;
		}

		.pickers {
			align-items: center;
			gap: 1rem;
		}

		.pickers:empty {
			display: none;
		}
	}
</style>
